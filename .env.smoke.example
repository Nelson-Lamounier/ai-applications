# =============================================================================
# E2E smoke harness configuration  —  copy to .env.smoke and fill the blanks
# =============================================================================
# `.env.smoke` is gitignored. `just smoke-e2e` loads it as KEY=VALUE lines.
# Everything except the Cognito test-user credentials is auto-discovered
# from the dev account (SSM + the platform/admin-api k8s secrets), so the
# only values you MUST set are the two marked REQUIRED.

# --- REQUIRED: dedicated dev Cognito test user (a fresh JWT is minted per run)
# Create a throwaway user in the dev user pool; its `sub` becomes the
# TEST_USER_ID, so every row this harness writes is naturally scoped to it.
SMOKE_COGNITO_USERNAME=
SMOKE_COGNITO_PASSWORD=

# --- AWS (defaults shown; override only if your setup differs)
AWS_PROFILE=dev-account
AWS_REGION=eu-west-1

# --- Discovery prefix for the chatbot SSM params (/<prefix>/api-url, /agent-api-key)
SMOKE_NAME_PREFIX=bedrock-dev

# --- Cognito app client id: auto-read from the admin-api k8s secret.
# Set this ONLY if the live lookup can't resolve it.
# SMOKE_COGNITO_CLIENT_ID=
# SMOKE_COGNITO_REGION=eu-west-1

# --- Safety guard (do NOT widen casually). cleanup hard-aborts unless the
# resolved DB name is in this allowlist AND the test user id is a UUID.
SMOKE_ALLOWED_DBS=tucaken

# --- Optional knobs
# SMOKE_FLOW_TIMEOUT=600000           # per-flow ms (default 10 min)
# SMOKE_INGEST_REPO=sindresorhus/is   # small public repo for ingestion
# SMOKE_ASSETS_BUCKET=                # only needed for the article-pipeline S3 draft
# SKIP_CLEANUP=1                      # retain rows + print what was kept (debugging)

# --- Admin-api route overrides — CONFIRM THESE AGAINST tucaken-app BEFORE
# THE FIRST LIVE RUN. The defaults are the verified routes; override only
# if tucaken-app changes them. Request-body field names (targetCompany,
# targetRole, jobDescription, resumeId / s3Key, slug / repoFullName /
# filename, contentType, fileSizeBytes) and the response id key
# (pipelineRunId | pipeline_run_id | id, applicationId, importId, slug)
# are normalised by admin-api-contract.ts — verify they match tucaken-app.
# SMOKE_ROUTE_STRATEGIST=/api/admin/pipelines/strategist-job
# SMOKE_ROUTE_ARTICLE=/api/admin/pipelines/article-job
# SMOKE_ROUTE_RESUME_UPLOAD=/api/admin/resume-imports/upload-url
# SMOKE_ROUTE_RESUME_COMPLETE=/api/admin/resume-imports
# SMOKE_ROUTE_INGESTION=/api/admin/ingestion/trigger
