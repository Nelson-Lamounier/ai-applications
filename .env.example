# Local developer environment — copy to .env and fill in values.
# Never commit .env — it is gitignored.
# CI reads these from GitHub Actions secrets.

# ── Job Strategist ───────────────────────────────────────────────────────────
# Full ECR repo URI: <account>.dkr.ecr.<region>.amazonaws.com/job-strategist
ECR_STRATEGIST=

# ── Resume Import Processor ──────────────────────────────────────────────────
# Full ECR repo URI: <account>.dkr.ecr.<region>.amazonaws.com/resume-import-processor
ECR_RESUME=

# RDS endpoint for the dev cluster (read from SSM /k8s/development/platform-rds/host)
RDS_HOST_DEV=

# S3 assets bucket name for the dev Bedrock Data stack
# (read from SSM or CDK output after deploy)
ASSETS_BUCKET_DEV=

# ── Chatbot ──────────────────────────────────────────────────────────────────
# Portfolio owner UUID — scopes chat sessions in the database
# Set once after initial DB setup; same value for all environments in single-owner mode
PORTFOLIO_OWNER_USER_ID=
