{
  "name": "ai-applications",
  "private": true,
  "description": "Bedrock AI applications — article pipeline, job strategist, chatbot, self-healing agent, and APIs",
  "workspaces": [
    "packages/script-utils",
    "applications/shared",
    "applications/article-pipeline",
    "applications/job-strategist",
    "applications/chatbot-public",
    "applications/chatbot-authenticated",
    "applications/self-healing",
    "applications/ingestion",
    "applications/tech-extractor",
    "applications/ontology-importer",
    "applications/resume-import-processor",
    "applications/synthetic-monitor",
    "applications/platform-job-watcher",
    "api/public-api",
    "infra",
    "mcp-servers/tucaken-smoke"
  ],
  "scripts": {
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "yarn workspaces foreach -A run test",
    "build": "yarn workspaces foreach -A run build",
    "lint": "eslint ."
  },
  "packageManager": "yarn@4.12.0",
  "resolutions": {
    "form-data": "^4.0.6",
    "esbuild": "0.28.1",
    "@grpc/grpc-js": "^1.14.4",
    "protobufjs": "^7.6.4",
    "ws": "^8.21.0",
    "undici@^6.25.0": "^6.27.0",
    "linkify-it": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "globals": "^17.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4"
  }
}
