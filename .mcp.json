{
  "mcpServers": {
    "tucaken-smoke": {
      "command": "node",
      "args": ["mcp-servers/tucaken-smoke/dist/index.js"],
      "env": { "AWS_PROFILE": "dev-account", "AWS_REGION": "eu-west-1" }
    },
    "eks": {
      "command": "uvx",
      "args": ["awslabs.eks-mcp-server@0.1.32"],
      "env": { "AWS_PROFILE": "dev-account", "AWS_REGION": "eu-west-1", "FASTMCP_LOG_LEVEL": "ERROR", "AWS_CA_BUNDLE": "/etc/ssl/cert.pem", "SSL_CERT_FILE": "/etc/ssl/cert.pem", "REQUESTS_CA_BUNDLE": "/etc/ssl/cert.pem" }
    },
    "cloudwatch": {
      "command": "uvx",
      "args": ["awslabs.cloudwatch-mcp-server@0.1.4"],
      "env": { "AWS_PROFILE": "dev-account", "AWS_REGION": "eu-west-1", "FASTMCP_LOG_LEVEL": "ERROR", "AWS_CA_BUNDLE": "/etc/ssl/cert.pem", "SSL_CERT_FILE": "/etc/ssl/cert.pem", "REQUESTS_CA_BUNDLE": "/etc/ssl/cert.pem" }
    },
    "aws-api": {
      "command": "uvx",
      "args": ["awslabs.aws-api-mcp-server@1.3.44"],
      "env": { "AWS_PROFILE": "dev-account", "AWS_REGION": "eu-west-1", "READ_OPERATIONS_ONLY": "true", "FASTMCP_LOG_LEVEL": "ERROR", "AWS_CA_BUNDLE": "/etc/ssl/cert.pem", "SSL_CERT_FILE": "/etc/ssl/cert.pem", "REQUESTS_CA_BUNDLE": "/etc/ssl/cert.pem" }
    }
  }
}
